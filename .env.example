# Proveniência e proteção de autoria
VITE_PROVENANCE_ENABLED=true
VITE_PROVENANCE_VISUAL_MARKER=true
VITE_PROVENANCE_STRENGTH=1.0
VITE_PROVENANCE_LABEL="Media Uniquifier"
VITE_PROVENANCE_FALLBACK=true

# Proteção visual anti-OCR / anti-CV (perceptual multi-layer)
VITE_VISUAL_PROC_ENABLED=true
VITE_VISUAL_PROC_STRENGTH=1.0
VITE_VISUAL_PROC_OVERLAY=false
VITE_VISUAL_PROC_OVERLAY_TEXT="PROTECTED"
VITE_VISUAL_PROC_MAX_FRAMES=
VITE_VISUAL_PROC_FALLBACK=true
